#!/usr/bin/env python3
"""Publish a Claude-generated HTML artifact as a progress-tracking course.

    bin/publish-course ~/Downloads/artifact.html "Linear Algebra Crash Course"
    bin/publish-course ~/Downloads/artifact.html --slug linear-algebra

Writes courses/<slug>/index.html, having made exactly two changes to the
artifact:

  1. Injected a deferred course-store.js tag near the top of <head>, carrying
     the course slug.
  2. Retagged the artifact's own inline scripts as type="text/course-deferred",
     so course-store.js can run them after remote progress has loaded.

Nothing else about the artifact is touched -- its markup, styles and logic ship
verbatim, which is what keeps this a copy-and-push operation rather than a
port. Re-running against an already-published course is safe.

This is also the retrofit path for artifacts that predate the store: run it
once per file and they gain sync without edits of their own.
"""

import argparse
import html as html_mod
import pathlib
import re
import subprocess
import sys

try:
    import yaml
except ImportError:  # optional: see parse_entry for the stand-in reader
    yaml = None

REPO = pathlib.Path(__file__).resolve().parent.parent
STORE_SRC = '/assets/js/course-store.js'
DEFERRED_TYPE = 'text/course-deferred'

# Script types that hold executable code. Anything else (application/json,
# text/template, importmap, ...) is data the artifact reads at runtime and must
# be left exactly where it is.
CODE_TYPES = {'', 'text/javascript', 'application/javascript', 'module'}

SCRIPT_OPEN = re.compile(r'<script\b([^>]*)>', re.IGNORECASE)
SCRIPT_BOUNDARY = re.compile(r'<script\b|</script\s*>', re.IGNORECASE)
ATTR_SRC = re.compile(r'\bsrc\s*=', re.IGNORECASE)
ATTR_TYPE = re.compile(r'\btype\s*=\s*["\']?([^"\'\s>]*)', re.IGNORECASE)
HEAD_OPEN = re.compile(r'<head\b[^>]*>', re.IGNORECASE)
CHARSET = re.compile(r'<meta\b[^>]*charset\b[^>]*>', re.IGNORECASE)
TITLE = re.compile(r'<title[^>]*>(.*?)</title>', re.IGNORECASE | re.DOTALL)
HTML_OPEN = re.compile(r'<html\b', re.IGNORECASE)


def slugify(text):
    slug = re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')
    if not slug:
        sys.exit('error: title produced an empty slug; pass --slug explicitly')
    return slug


def find_body_end(html, start):
    """Index just past the </script> closing the element whose body starts here.

    Bundled artifacts frequently contain the literal text "<script>" inside
    their own JavaScript. A real HTML parser enters a double-escaped state at
    that point, so the *next* </script> does not close the element -- and a
    naive search would stop early and split the bundle mid-expression. Counting
    depth reproduces that behaviour closely enough.
    """
    depth = 1
    pos = start
    while True:
        match = SCRIPT_BOUNDARY.search(html, pos)
        if not match:
            return len(html)
        if match.group(0).startswith('</'):
            depth -= 1
            if depth == 0:
                return match.end()
        else:
            depth += 1
        pos = match.end()


def retag_inline_scripts(html):
    """Mark inline code scripts as deferred. Returns (html, count).

    Walks the document with a cursor that jumps over each script's body, so
    text that merely looks like a script tag inside JavaScript is never
    rewritten. An earlier regex-over-everything version corrupted a 380KB
    bundle exactly that way.
    """
    count = 0
    out = []
    pos = 0

    def rewrite_open_tag(match):
        nonlocal count
        attrs = match.group(1)

        # External scripts (CDN libraries) are left alone: they do not touch
        # localStorage, and letting them load normally preserves both their
        # download parallelism and their ordering ahead of inline code.
        if ATTR_SRC.search(attrs):
            return match.group(0)

        type_match = ATTR_TYPE.search(attrs)
        script_type = (type_match.group(1) if type_match else '').lower()
        if script_type not in CODE_TYPES:
            return match.group(0)
        if script_type == DEFERRED_TYPE:
            return match.group(0)

        count += 1
        # Strip any existing type, then apply ours. ES modules are flagged so
        # course-store.js can restore type="module" when re-executing them.
        cleaned = ATTR_TYPE.sub('', attrs).rstrip()
        marker = ' data-course-module' if script_type == 'module' else ''
        return '<script type="%s"%s%s>' % (
            DEFERRED_TYPE,
            marker,
            (' ' + cleaned.strip()) if cleaned.strip() else '',
        )

    while True:
        match = SCRIPT_OPEN.search(html, pos)
        if not match:
            out.append(html[pos:])
            break
        out.append(html[pos : match.start()])
        out.append(rewrite_open_tag(match))
        body_end = find_body_end(html, match.end())
        out.append(html[match.end() : body_end])
        pos = body_end

    return ''.join(out), count


def ensure_document(html):
    """Wrap a bare fragment in a document shell. Returns (html, wrapped).

    Not every artifact arrives as a full document -- some begin straight at
    <title> or <style> with no doctype, <html> or <head>. Browsers render those
    in quirks mode with a locale-derived encoding, which is how UTF-8 punctuation
    turns into mojibake. A stray <title> inside <body> is fine: the parser
    handles it with the in-head rules, so document.title still resolves.
    """
    if HTML_OPEN.search(html) or HEAD_OPEN.search(html):
        return html, False

    shell = (
        '<!doctype html>\n'
        '<html lang="en">\n'
        '<head>\n'
        '    <meta charset="utf-8">\n'
        '    <meta name="viewport" content="width=device-width, '
        'initial-scale=1">\n'
        '</head>\n'
        '<body>\n'
        '%s\n'
        '</body>\n'
        '</html>\n'
    )
    return shell % html.strip(), True


def ensure_charset(html):
    """Guarantee a <meta charset> declaration. Returns (html, added).

    Artifacts do not always include one. GitHub Pages happens to send
    charset=utf-8 in its Content-Type header, which masks the omission live --
    but the same file then renders mojibake locally, over file://, or anywhere
    the header differs. Declaring it in the document removes the dependency.
    """
    if CHARSET.search(html):
        return html, False

    head = HEAD_OPEN.search(html)
    if not head:
        return html, False
    at = head.end()
    return html[:at] + '\n    <meta charset="utf-8">' + html[at:], True


def extract_title(html):
    """The artifact's own <title>, collapsed to one line."""
    match = TITLE.search(html)
    if not match:
        return ''
    return html_mod.unescape(' '.join(match.group(1).split()))


def split_index(raw):
    """Split _data/courses.yml into (header, [entry block, ...]).

    The file is handled as text rather than loaded and re-emitted, because a
    YAML dumper would reflow the hand-written folded descriptions and drop the
    header comment. Cutting the document at each top-level `- ` leaves every
    byte we are not deliberately changing exactly as it was.
    """
    header = []
    blocks = []
    for line in raw.splitlines(keepends=True):
        if line.startswith('- ') or line.rstrip('\n') == '-':
            blocks.append([line])
        elif blocks:
            blocks[-1].append(line)
        else:
            # Everything ahead of the first entry -- comments, blank lines --
            # is header, and rides along untouched.
            header.append(line)
    return ''.join(header), [''.join(block) for block in blocks]


def entry_field(block, key):
    """Locate an inline `key:` line in one entry block.

    Returns (value, start, end) spanning the whole line including its `- ` or
    two-space indent, or None when the key is absent. Only inline scalars are
    handled, which covers every field this tool reads or writes; `description`
    may be a folded block and is never touched.
    """
    pattern = re.compile(
        r'^(?:- |  )%s:[^\S\n]*(.*)$' % re.escape(key), re.MULTILINE
    )
    match = pattern.search(block)
    if not match:
        return None
    return match.group(1).strip(), match.start(), match.end()


def unquote_scalar(text):
    if len(text) >= 2 and text[0] == text[-1] and text[0] in '\'"':
        inner = text[1:-1]
        return inner.replace("''", "'") if text[0] == "'" else inner
    return text


def as_bool(value):
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ('true', 'yes', 'on', '1')


def emit_scalar(value):
    """Render a scalar, quoting only when plain style would change its meaning."""
    if isinstance(value, bool):
        return 'true' if value else 'false'
    text = str(value)
    unsafe = re.search(r'^[\s>|&*!%@`#?-]|[:#]\s|[:\'"\[\]{},]|\s$', text)
    reserved = text.lower() in (
        '', 'true', 'false', 'yes', 'no', 'on', 'off', 'null', '~',
    )
    if unsafe or reserved:
        return "'%s'" % text.replace("'", "''")
    return text


def parse_entry(block):
    """Read slug/title/tracked out of one entry block.

    PyYAML does it when installed; the fallback covers the same three inline
    scalars with a regex, so a missing module no longer costs us the index
    update it used to skip.
    """
    if yaml is not None:
        try:
            loaded = yaml.safe_load(block)
        except yaml.YAMLError:
            loaded = None
        if isinstance(loaded, list) and loaded and isinstance(loaded[0], dict):
            return loaded[0]

    entry = {}
    for key in ('slug', 'title', 'tracked'):
        field = entry_field(block, key)
        if field:
            entry[key] = unquote_scalar(field[0])
    return entry


def set_field(block, key, value):
    """Rewrite one inline field in an entry block, appending the line if absent."""
    rendered = '%s: %s' % (key, emit_scalar(value))
    field = entry_field(block, key)
    if field:
        _, start, end = field
        indent = '- ' if block[start : start + 2] == '- ' else '  '
        return block[:start] + indent + rendered + block[end:]

    at = block.index('\n') + 1 if '\n' in block else len(block)
    return block[:at] + '  ' + rendered + '\n' + block[at:]


def upsert_course_index(slug, title, tracked):
    """Add or refresh this course's entry in _data/courses.yml.

    Returns 'added', 'updated' or None. A new course appends a block; a known
    one has only its `title` and `tracked` lines rewritten. Hand-written
    descriptions, the header comment and the other entries stay byte-for-byte,
    and the file is only written when something actually changed.
    """
    path = REPO / '_data' / 'courses.yml'
    raw = path.read_text(encoding='utf-8') if path.exists() else ''
    header, blocks = split_index(raw)

    outcome = None
    for index, block in enumerate(blocks):
        entry = parse_entry(block)
        if entry.get('slug') != slug:
            continue
        if title and entry.get('title') != title:
            block = set_field(block, 'title', title)
            outcome = 'updated'
        if as_bool(entry.get('tracked')) != tracked:
            block = set_field(block, 'tracked', tracked)
            outcome = 'updated'
        blocks[index] = block
        break
    else:
        blocks.append(
            '- slug: %s\n  title: %s\n  description: %s\n  tracked: %s\n'
            % (
                emit_scalar(slug),
                emit_scalar(title or slug),
                emit_scalar(''),
                emit_scalar(tracked),
            )
        )
        outcome = 'added'

    if not outcome:
        return None

    # One blank line between entries, whatever the spacing was going in.
    body = '\n\n'.join(block.strip('\n') for block in blocks)
    text = header.strip('\n')
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        (text + '\n\n' if text else '') + body + '\n', encoding='utf-8'
    )
    return outcome


def inject_store(html, slug):
    """Insert the two script tags early in <head>, after any charset meta."""
    # One tag, deferred. course-store.js fetches supabase-js itself, so an
    # unreachable CDN cannot stall the artifact.
    tags = '\n    <script src="%s" defer data-course-slug="%s"></script>' % (
        STORE_SRC,
        slug,
    )

    head = HEAD_OPEN.search(html)
    if head:
        # Go after <meta charset> when there is one: the encoding declaration
        # must stay near the top of the document, and inserting above it would
        # push it down for no benefit.
        charset = CHARSET.search(html, head.end())
        at = charset.end() if charset else head.end()
        return html[:at] + tags + html[at:]

    # Artifacts nearly always have a <head>; if one does not, prepend so the
    # store still runs before any inline script in the document.
    return tags.lstrip('\n') + '\n' + html


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source', help='path to the artifact HTML file')
    parser.add_argument('title', nargs='?', help='course title (used for slug)')
    parser.add_argument('--slug', help='slug override')
    parser.add_argument(
        '--commit', action='store_true', help='git add + commit the result'
    )
    parser.add_argument(
        '--no-store',
        action='store_true',
        help='publish verbatim, without progress tracking (static reading '
        'material with no state to persist)',
    )
    args = parser.parse_args()

    if not args.title and not args.slug:
        sys.exit('error: provide a title or --slug')

    source = pathlib.Path(args.source).expanduser()
    if not source.is_file():
        sys.exit('error: no such file: %s' % source)

    slug = args.slug or slugify(args.title)
    html = source.read_text(encoding='utf-8')
    title = args.title or extract_title(html)

    html, wrapped = ensure_document(html)
    if wrapped:
        print('- wrapped bare fragment in a document shell')

    html, charset_added = ensure_charset(html)
    if charset_added:
        print('- added missing <meta charset="utf-8">')

    if args.no_store:
        print('- --no-store: publishing verbatim, no progress tracking')
        deferred = -1
    elif STORE_SRC in html:
        print('- store already present; leaving script tags as they are')
        deferred = html.count('type="%s"' % DEFERRED_TYPE)
    else:
        html, deferred = retag_inline_scripts(html)
        html = inject_store(html, slug)

    if deferred == 0:
        print(
            '! no inline scripts were deferred -- if this artifact keeps its\n'
            '  progress in memory or IndexedDB rather than localStorage, the\n'
            '  store has nothing to intercept and it needs a real edit.'
        )

    target = REPO / 'courses' / slug / 'index.html'
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(html, encoding='utf-8')

    index_result = upsert_course_index(slug, title, not args.no_store)
    if index_result == 'added':
        print('- added to _data/courses.yml (write a description there)')
    elif index_result == 'updated':
        print('- refreshed entry in _data/courses.yml')

    rel = target.relative_to(REPO)
    print('published %s' % rel)
    print('  slug:            %s' % slug)
    print('  title:           %s' % (title or '(none found)'))
    print(
        '  inline scripts:  %s'
        % ('n/a (no store)' if deferred < 0 else '%d deferred' % deferred)
    )
    print('  url:             https://bennorris.com/courses/%s/' % slug)

    # The index entry is part of publishing, so it travels with the course.
    # Paths are named explicitly rather than using `git add .`, which would pick
    # up unrelated work in progress elsewhere in the repo.
    paths = [str(rel)]
    if index_result in ('added', 'updated'):
        paths.append('_data/courses.yml')

    if args.commit:
        subprocess.run(['git', '-C', str(REPO), 'add'] + paths, check=True)
        subprocess.run(
            ['git', '-C', str(REPO), 'commit', '-m', 'Publish course: %s' % slug],
            check=True,
        )
        print('  committed (not pushed)')
    else:
        print('\nnext: git add %s && git commit && git push' % ' '.join(paths))


if __name__ == '__main__':
    main()
